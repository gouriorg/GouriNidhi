# Default project for local `npm run dev` (never commit real keys).
#
# Switch account without code changes:
# - This browser: Settings → Switch project (or Login → different project)
# - Every device: replace /supabase.config.json on the host, OR set these two
#   Vercel env vars and Redeploy. First publish: npm run deploy
#
# New account checklist:
# 1. Create a project at https://supabase.com
# 2. Authentication → Providers → Email: turn OFF Confirm email
# 3. Project Settings → API: copy URL and publishable/anon key
# 4. Paste them here, in Settings, or in supabase.config.json
# 5. Run Settings → Download setup SQL in the SQL editor
# Do not put the database password or service role key in this file.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
